<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exclusif — Contenu</title>
    <link rel="manifest" href="/public/manifest.json">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen">

    <!-- Modal de vérification d'âge obligatoirement affiché au premier accès -->
    <div id="age-modal" class="fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
        <div class="bg-slate-800 max-w-md w-full p-6 rounded-2xl border border-slate-700 text-center space-y-4">
            <h2 class="text-xl font-bold">Avertissement — Contenu Adulte</h2>
            <p class="text-slate-400 text-sm">Vous devez avoir au moins 18 ans pour accéder à cette application.</p>
            <div class="flex gap-4 pt-2">
                <button onclick="confirmAge()" class="flex-1 bg-rose-600 hover:bg-rose-700 py-3 rounded-xl font-bold transition">J'ai 18 ans ou plus</button>
                <a href="https://www.google.com" class="flex-1 bg-slate-700 hover:bg-slate-600 py-3 rounded-xl font-bold transition flex items-center justify-center">Quitter</a>
            </div>
        </div>
    </div>

    <!-- Application principale -->
    <header class="p-4 border-b border-slate-800 flex justify-between items-center">
        <h1 class="text-lg font-bold text-rose-500">Exclusif</h1>
        <button id="install-btn" class="hidden bg-slate-800 text-xs px-3 py-2 rounded-lg border border-slate-700">Installer l'app</button>
    </header>

    <main class="max-w-md mx-auto p-4 space-y-6" id="feed">
        <!-- Carte de média payant (exemple statique) -->
        <article class="bg-slate-800 rounded-2xl overflow-hidden border border-slate-700">
            <div class="relative aspect-square bg-slate-950">
                <!-- Image avec effet d'arrière-plan flouté -->
                <img src="https://via.placeholder.com/600/111827/ffffff?text=Apercu" alt="Preview" class="w-full h-full object-cover blur-lg">
                <div class="absolute inset-0 flex flex-col items-center justify-center p-4 bg-black/40">
                    <span class="text-3xl mb-2">🔒</span>
                    <p class="font-semibold mb-3">Photo exclusive</p>
                    <button class="bg-rose-600 hover:bg-rose-700 px-6 py-2.5 rounded-xl font-bold text-sm transition">Débloquer pour 4,99 €</button>
                </div>
            </div>
            <div class="p-4">
                <p class="text-sm text-slate-300">Set photo exclusif du week-end.</p>
            </div>
        </article>
    </main>

    <script src="app.js"></script>
</body>
</html>
