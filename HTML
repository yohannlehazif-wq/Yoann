<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"><title>RESTEV 85 - Entrepôt VR</title><script src="https://aframe.io/releases/1.8.0/aframe.min.js"></script><style>body{margin:0;font-family:Arial}.hud{position:fixed;z-index:10;top:12px;left:12px;background:#102c3ddd;color:white;padding:12px 16px;border-radius:12px;max-width:330px}.hud b{color:#53d1c9}.hud button{border:0;border-radius:8px;padding:8px 11px;font-weight:700;margin:6px 4px 0 0}.mag{background:#a71974;color:white}.teal{background:#218c8d;color:white}.a-enter-vr-button{background:#a71974!important;border-radius:10px!important}.notice{font-size:12px;opacity:.85}</style></head><body><div class="hud"><b>RESTEV 85 · CHASSE AUX RISQUES VR</b><div>Repérez 8 dangers. Visez un repère rouge puis pressez la gâchette ou cliquez.</div><div>Score : <span id="score">0</span>/8 · <span id="message">Explorez l'entrepôt.</span></div><button class="teal" onclick="document.querySelector('a-scene').enterVR()">ENTRER EN VR</button><button class="mag" onclick="location.reload()">RECOMMENCER</button><div class="notice">Casque WebXR : ouvrir la page HTTPS dans le navigateur du casque.</div></div>
<a-scene renderer="antialias:true;colorManagement:true" webxr="optionalFeatures: local-floor, bounded-floor" xr-mode-ui="enabled:true" background="color:#a9c8d8" shadow="type:pcfsoft">
<a-assets><a-mixin id="rack" geometry="primitive:box;width:0.16;height:3.4;depth:1.2" material="color:#31516b;metalness:.5"></a-mixin><a-mixin id="beam" geometry="primitive:box;width:4;height:.12;depth:1.2" material="color:#d17f22;metalness:.3"></a-mixin></a-assets>
<a-entity light="type:ambient;intensity:.75;color:#dfefff"></a-entity><a-entity light="type:directional;intensity:.7;castShadow:true" position="1 7 2"></a-entity>
<a-plane rotation="-90 0 0" width="28" height="34" color="#7f878b" shadow="receive:true"></a-plane><a-plane position="0 5 -12" width="28" height="10" color="#dce5e8"></a-plane><a-plane position="-14 5 0" rotation="0 90 0" width="34" height="10" color="#dce5e8"></a-plane><a-plane position="14 5 0" rotation="0 -90 0" width="34" height="10" color="#dce5e8"></a-plane>
<!-- marquages --> <a-plane rotation="-90 0 0" position="0 .012 -1" width="2.4" height="30" color="#d7c82e"></a-plane><a-plane rotation="-90 0 0" position="0 .02 -1" width="1.9" height="30" color="#7f878b"></a-plane>
<!-- racks -->
<a-entity position="-7 0 -4"><a-box mixin="rack" position="-2 1.7 0"></a-box><a-box mixin="rack" position="2 1.7 0"></a-box><a-box mixin="beam" position="0 .7 0"></a-box><a-box mixin="beam" position="0 1.9 0"></a-box><a-box mixin="beam" position="0 3.1 0"></a-box><a-box position="-1 .35 0" width="1.6" height=".65" depth="1" color="#bc7b39"></a-box><a-box position="1 2.42 0" rotation="0 0 12" width="1.7" height=".85" depth="1" color="#c88a48"></a-box></a-entity>
<a-entity position="7 0 -7"><a-box mixin="rack" position="-2 1.7 0"></a-box><a-box mixin="rack" position="2 1.7 0"></a-box><a-box mixin="beam" position="0 .7 0"></a-box><a-box mixin="beam" position="0 1.9 0"></a-box><a-box mixin="beam" position="0 3.1 0"></a-box><a-box position="-.8 1.3 0" width="1.7" height="1" depth="1" color="#b97638"></a-box></a-entity>
<!-- chariot --> <a-entity position="3 0 -2" rotation="0 -28 0"><a-box position="0 .65 0" width="2.2" height="1.2" depth="1.35" color="#e3a51e" shadow="cast:true"></a-box><a-box position="-.45 1.8 0" width=".9" height="1.6" depth="1.25" color="#91c8dc" opacity=".7"></a-box><a-cylinder rotation="90 0 0" position="-.7 .25 .72" radius=".32" height=".18" color="#222"></a-cylinder><a-cylinder rotation="90 0 0" position=".7 .25 .72" radius=".32" height=".18" color="#222"></a-cylinder><a-box position="1.35 .38 0" width=".15" height="2.1" depth="1.2" color="#333"></a-box><a-box position="2.25 .1 .35" width="2" height=".08" depth=".12" color="#333"></a-box><a-box position="2.25 .1 -.35" width="2" height=".08" depth=".12" color="#333"></a-box></a-entity>
<!-- piéton --> <a-entity position="1 0 -3"><a-cylinder position="0 1.05 0" height="1.4" radius=".28" color="#1d72a0"></a-cylinder><a-sphere position="0 1.95 0" radius=".28" color="#c98e69"></a-sphere></a-entity>
<!-- palette allée --> <a-entity position="0 .12 -6"><a-box width="2.2" height=".22" depth="1.3" color="#9a662e"></a-box><a-box position="0 .55 0" width="1.7" height=".8" depth="1" color="#bf7f3b"></a-box></a-entity>
<!-- fuite --> <a-circle rotation="-90 0 0" position="-2 .025 1" radius="1.1" color="#347eb0" opacity=".75"></a-circle>
<!-- sortie --> <a-box position="11 1.5 -11.85" width="2.2" height="3" depth=".12" color="#39745f"></a-box><a-text value="SORTIE" align="center" position="11 3.3 -11.7" color="#168445" width="5"></a-text><a-box position="11 .45 -10.8" width="2" height=".9" depth="1.2" color="#bb7939"></a-box>
<!-- câble --> <a-torus position="-1 .08 5" rotation="90 0 28" radius="1.8" radius-tubular=".045" arc="160" color="#161616"></a-torus>
<!-- échelle --> <a-entity position="-12 1.8 -7" rotation="0 0 -18"><a-box position="-.45 0 0" width=".1" height="3.6" depth=".1" color="#bbb"></a-box><a-box position=".45 0 0" width=".1" height="3.6" depth=".1" color="#bbb"></a-box><a-box position="0 -1.2 0" width=".9" height=".08" depth=".1" color="#bbb"></a-box><a-box position="0 -.6 0" width=".9" height=".08" depth=".1" color="#bbb"></a-box><a-box position="0 0 0" width=".9" height=".08" depth=".1" color="#bbb"></a-box><a-box position="0 .6 0" width=".9" height=".08" depth=".1" color="#bbb"></a-box><a-box position="0 1.2 0" width=".9" height=".08" depth=".1" color="#bbb"></a-box></a-entity>
<!-- machine sans carter --> <a-box position="-5 1 5" width="3" height="2" depth="2" color="#487a88"></a-box><a-cylinder position="-5 2 3.9" rotation="90 0 0" radius=".55" height=".2" color="#222"></a-cylinder>
<!-- extincteur masqué --> <a-cylinder position="-10 .65 8" radius=".22" height="1.1" color="#d73528"></a-cylinder><a-box position="-10 .6 7.5" width="1.4" height="1.2" depth="1" color="#bb7939"></a-box>
<!-- hazards --> <a-entity id="hazards"></a-entity>
<a-entity id="rig" position="0 0 10"><a-camera look-controls wasd-controls="acceleration:25" position="0 1.65 0"><a-cursor raycaster="objects:.hazard" fuse="false" color="#fff"></a-cursor></a-camera><a-entity laser-controls="hand:right" raycaster="objects:.hazard"></a-entity><a-entity laser-controls="hand:left" raycaster="objects:.hazard"></a-entity></a-entity>
</a-scene><script>
const risks=[['Stockage instable','-6 2.7 -3.25'],['Câble au sol','-1 .2 5'],['Palette dans l’allée','0 1.2 -6'],['Liquide au sol','-2 .2 1'],['Coactivité chariot-piéton','1 2.4 -3'],['Sortie encombrée','11 2 -10.6'],['Échelle mal positionnée','-12 3 -7'],['Machine sans carter','-5 2.5 3.8']];let score=0;const container=document.querySelector('#hazards');risks.forEach((r,i)=>{const e=document.createElement('a-sphere');e.setAttribute('class','hazard');e.setAttribute('position',r[1]);e.setAttribute('radius','.28');e.setAttribute('color','#d52b1e');e.setAttribute('emissive','#d52b1e');e.setAttribute('animation','property:scale;dir:alternate;dur:700;loop:true;to:1.35 1.35 1.35');e.setAttribute('data-name',r[0]);e.addEventListener('click',()=>{if(e.dataset.done)return;e.dataset.done='1';score++;e.setAttribute('color','#16a05d');e.setAttribute('animation','property:scale;to:.5 .5 .5;dur:300');document.querySelector('#score').textContent=score;document.querySelector('#message').textContent='Trouvé : '+r[0];if(score===8)document.querySelector('#message').textContent='Mission terminée ! Débriefing avec le formateur.'});container.appendChild(e)});
const scene=document.querySelector('a-scene');function resize(){if(scene.renderer){scene.resize();scene.renderer.setSize(innerWidth,innerHeight,false)}}addEventListener('load',()=>setTimeout(resize,250));addEventListener('resize',resize);new ResizeObserver(resize).observe(document.body);
</script></body></html>
