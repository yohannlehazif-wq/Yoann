<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exclusif — Aperçu</title>
    <style>
        body { margin: 0; font-family: system-ui, sans-serif; background-color: #0f172a; color: white; display: flex; justify-content: center; }
        .app { width: 100%; max-width: 400px; padding: 16px; box-sizing: border-box; }
        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 12px; margin-bottom: 20px; }
        .logo { font-weight: bold; color: #f43f5e; font-size: 1.2rem; }
        .card { background: #1e293b; border-radius: 16px; border: 1px solid #334155; overflow: hidden; margin-bottom: 16px; }
        .media-box { position: relative; aspect-ratio: 1; background: #020617; display: flex; align-items: center; justify-content: center; }
        .blur-bg { position: absolute; inset: 0; background: linear-gradient(135deg, #e11d48, #4f46e5); filter: blur(20px); opacity: 0.5; }
        .overlay { position: relative; z-index: 10; text-align: center; }
        .btn-unlock { background: #e11d48; color: white; border: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: center; z-index: 50; padding: 16px; }
        .modal-box { background: #1e293b; padding: 24px; border-radius: 16px; text-align: center; max-width: 320px; border: 1px solid #334155; }
        .btn-confirm { background: #e11d48; color: white; border: none; padding: 10px; border-radius: 8px; width: 100%; font-weight: bold; cursor: pointer; margin-top: 12px; }
        .hidden { display: none !important; }
    </style>
</head>
<body>

    <!-- Modal d'âge -->
    <div id="age-modal" class="modal">
        <div class="modal-box">
            <h3>Avertissement +18</h3>
            <p style="color: #94a3b8; font-size: 0.9rem;">Accès réservé aux personnes majeures.</p>
            <button onclick="document.getElementById('age-modal').classList.add('hidden')" class="btn-confirm">J'ai 18 ans ou plus</button>
        </div>
    </div>

    <!-- Application -->
    <div class="app">
        <div class="header">
            <div class="logo">Exclusif</div>
        </div>

        <div class="card">
            <div class="media-box">
                <div class="blur-bg"></div>
                <div class="overlay">
                    <div style="font-size: 2rem;">🔒</div>
                    <p style="margin: 4px 0; font-weight: bold;">Photo masquée</p>
                    <button class="btn-unlock">Débloquer pour 4,99 €</button>
                </div>
            </div>
            <div style="padding: 12px; font-size: 0.9rem; color: #cbd5e1;">
                Contenu exclusif de la semaine.
            </div>
        </div>
    </div>

</body>
</html>
