<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-900">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RESTEV - Chasse aux Risques VR</title>
    
    <!-- A-Frame VR Framework -->
    <script src="https://aframe.io/releases/1.4.2/aframe.min.js"></script>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.js">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Font: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            user-select: none;
            overflow: hidden;
        }

        /* Glassmorphic Panel Styling */
        .glass-panel {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Pulse glow for target indicators */
        @keyframes pulse-glow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.9; transform: scale(1.15); }
        }

        .animate-pulse-glow {
            animation: pulse-glow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        /* Custom Scrollbar for Modals */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(13, 148, 136, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(13, 148, 136, 0.8);
        }

        /* Hide A-Frame default VR button since we manage a custom UI */
        .a-enter-vr {
            bottom: 20px !important;
            right: 20px !important;
            z-index: 40 !important;
        }
    </style>
</head>
<body class="h-full text-slate-100 flex flex-col justify-between select-none bg-slate-950">

    <!-- TOP HUD OVERLAY -->
    <header class="fixed top-0 left-0 right-0 z-30 p-3 sm:p-4 pointer-events-none">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
            
            <!-- Brand & Logo -->
            <div class="pointer-events-auto flex items-center gap-3 glass-panel px-4 py-2.5 rounded-2xl shadow-xl">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-600 to-emerald-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg">
                    R
                </div>
                <div>
                    <h1 class="text-sm sm:text-base font-extrabold tracking-wide text-white leading-tight">
                        RESTEV <span class="text-teal-400 font-normal">| Santé au Travail</span>
                    </h1>
                    <p class="text-xs text-slate-400 hidden sm:block">Chasse aux Risques en Atelier 3D/VR</p>
                </div>
            </div>

            <!-- Game Stats & HUD Indicators -->
            <div class="pointer-events-auto flex items-center gap-2 sm:gap-4 glass-panel px-4 py-2.5 rounded-2xl shadow-xl">
                <!-- Score Counter -->
                <div class="flex items-center gap-2 border-r border-slate-700/80 pr-3 sm:pr-4">
                    <i class="fa-solid fa-triangle-exclamation text-amber-400 text-base sm:text-lg"></i>
                    <div>
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block leading-none">Risques</span>
                        <span id="score-text" class="text-base sm:text-lg font-black text-white">0 / 5</span>
                    </div>
                </div>

                <!-- Timer -->
                <div class="flex items-center gap-2">
                    <i class="fa-regular fa-clock text-teal-400 text-base sm:text-lg"></i>
                    <div>
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block leading-none">Temps</span>
                        <span id="timer-text" class="text-base sm:text-lg font-black font-mono text-teal-300">00:00</span>
                    </div>
                </div>
            </div>

            <!-- Control Buttons -->
            <div class="pointer-events-auto flex items-center gap-2">
                <button id="btn-sound" onclick="toggleAudio()" class="glass-panel hover:bg-slate-800 text-slate-200 w-11 h-11 rounded-2xl flex items-center justify-center transition-all duration-200 active:scale-95 shadow-lg" title="Activer/Désactiver le son">
                    <i id="sound-icon" class="fa-solid fa-volume-high text-teal-400"></i>
                </button>
                <button onclick="showHelpModal()" class="glass-panel hover:bg-slate-800 text-slate-200 w-11 h-11 rounded-2xl flex items-center justify-center transition-all duration-200 active:scale-95 shadow-lg" title="Aide & Commandes">
                    <i class="fa-solid fa-circle-question text-teal-400"></i>
                </button>
                <button onclick="resetSimulation()" class="glass-panel hover:bg-slate-800 text-slate-200 w-11 h-11 rounded-2xl flex items-center justify-center transition-all duration-200 active:scale-95 shadow-lg" title="Réinitialiser">
                    <i class="fa-solid fa-rotate-right text-slate-300"></i>
                </button>
            </div>

        </div>
    </header>

    <!-- WELCOME MODAL -->
    <div id="modal-welcome" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md transition-opacity duration-300">
        <div class="glass-panel max-w-xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl border border-slate-700/60 relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 rounded-2xl bg-teal-500/20 text-teal-400 flex items-center justify-center text-2xl font-bold">
                    <i class="fa-solid fa-vr-cardboard"></i>
                </div>
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-teal-400">Module de Prévention RESTEV</span>
                    <h2 class="text-2xl font-black text-white">Chasse aux Risques en Atelier</h2>
                </div>
            </div>

            <p class="text-slate-300 text-sm sm:text-base mb-6 leading-relaxed">
                Bienvenue dans cette simulation immersive de sécurité au travail. Votre mission est de repérer et corriger <strong class="text-teal-300">5 situations dangereuses</strong> dissimulées dans l'atelier industriel avant la fin du temps.
            </p>

            <div class="space-y-3 mb-8">
                <div class="glass-card p-3.5 rounded-xl flex items-start gap-3">
                    <i class="fa-solid fa-computer-mouse text-teal-400 mt-1"></i>
                    <div class="text-xs sm:text-sm text-slate-300">
                        <strong class="text-white block">Sur Ordinateur / Mobile :</strong>
                        Déplacez-vous avec les touches <kbd class="px-1.5 py-0.5 bg-slate-800 rounded border border-slate-600 font-mono text-slate-200">ZQSD</kbd> ou les flèches, orientez le regard à la souris/toucher et cliquez sur les anomalies.
                    </div>
                </div>
                <div class="glass-card p-3.5 rounded-xl flex items-start gap-3">
                    <i class="fa-solid fa-headset text-teal-400 mt-1"></i>
                    <div class="text-xs sm:text-sm text-slate-300">
                        <strong class="text-white block">En Casque VR (Meta Quest, etc.) :</strong>
                        Cliquez sur le bouton <span class="text-teal-300 font-semibold">"VR"</span> en bas à droite pour entrer en immersion totale. Utilisez la gâchette des manettes pour pointer et sélectionner.
                    </div>
                </div>
            </div>

            <button onclick="startSimulation()" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-400 hover:to-emerald-400 text-slate-950 font-extrabold text-base tracking-wide shadow-lg shadow-teal-500/25 transition-all duration-200 transform active:scale-98 flex items-center justify-center gap-2">
                <i class="fa-solid fa-play"></i> Démarrer l'Inspection
            </button>
        </div>
    </div>

    <!-- HAZARD DETAIL MODAL -->
    <div id="modal-hazard" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden transition-all duration-300">
        <div class="glass-panel max-w-2xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl border border-slate-700/60 relative max-h-[90vh] flex flex-col justify-between">
            
            <div class="overflow-y-auto pr-2">
                <!-- Header badge -->
                <div class="flex items-center justify-between mb-4">
                    <span id="hazard-category-badge" class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        Risque Détecté
                    </span>
                    <span id="hazard-step-text" class="text-xs font-bold text-slate-400">1 / 5 Identifié</span>
                </div>

                <h3 id="hazard-title" class="text-xl sm:text-2xl font-black text-white mb-3">Titre du Risque</h3>
                
                <div class="p-4 bg-slate-900/80 rounded-2xl border border-slate-800 mb-5">
                    <h4 class="text-xs uppercase font-bold text-slate-400 tracking-wider mb-1">Constat sur le terrain</h4>
                    <p id="hazard-description" class="text-slate-200 text-sm sm:text-base leading-relaxed">Description détaillée du problème constaté...</p>
                </div>

                <!-- Regulatory & RESTEV Recommendations -->
                <div class="space-y-4 mb-6">
                    <div class="border-l-4 border-amber-500 pl-4 py-1">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-amber-400">Cadre Réglementaire (Code du Travail / INRS)</h4>
                        <p id="hazard-regulation" class="text-xs sm:text-sm text-slate-300 mt-1">Référence légale ou norme associée.</p>
                    </div>

                    <div class="border-l-4 border-teal-500 pl-4 py-1">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-teal-400">Préconisation & Action RESTEV</h4>
                        <p id="hazard-prevention" class="text-xs sm:text-sm text-slate-300 mt-1">Actions correctives prioritaires à mettre en œuvre.</p>
                    </div>
                </div>
            </div>

            <!-- Modal Action Footer -->
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-end">
                <button onclick="closeHazardModal()" class="w-full sm:w-auto py-3 px-6 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-400 hover:to-emerald-400 text-slate-950 font-bold text-sm tracking-wide shadow-md transition-all active:scale-95 flex items-center justify-center gap-2">
                    Compris, Continuer <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- VICTORY MODAL -->
    <div id="modal-victory" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-lg hidden transition-all duration-300">
        <div class="glass-panel max-w-xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl border border-emerald-500/40 text-center relative overflow-hidden">
            <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-48 h-48 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none"></div>

            <div class="w-20 h-20 rounded-3xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-4xl mx-auto mb-4 border border-emerald-500/40 shadow-inner">
                <i class="fa-solid fa-trophy"></i>
            </div>

            <span class="text-xs font-extrabold uppercase tracking-widest text-emerald-400">Félicitations !</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1 mb-2">Inspection Terminée avec Succès</h2>
            <p class="text-slate-300 text-sm mb-6">Vous avez identifié l'ensemble des 5 risques critiques de l'atelier RESTEV.</p>

            <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="glass-card p-4 rounded-2xl">
                    <span class="text-xs text-slate-400 font-semibold block uppercase">Risques Résolus</span>
                    <span class="text-2xl font-black text-emerald-400">5 / 5</span>
                </div>
                <div class="glass-card p-4 rounded-2xl">
                    <span class="text-xs text-slate-400 font-semibold block uppercase">Temps Effectué</span>
                    <span id="final-time" class="text-2xl font-black text-teal-300 font-mono">00:00</span>
                </div>
            </div>

            <div class="p-4 bg-teal-950/40 rounded-2xl border border-teal-800/50 text-left mb-6">
                <div class="flex items-center gap-2 text-teal-300 font-bold text-sm mb-1">
                    <i class="fa-solid fa-shield-heart"></i> Engagement RESTEV
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                    Un atelier sécurisé repose sur la vigilance de chacun. Transmettez ces réflexes dans vos équipes et faites appel aux préventeurs RESTEV pour vos évaluations de risques (DUERP).
                </p>
            </div>

            <button onclick="resetSimulation()" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-extrabold text-base tracking-wide shadow-lg shadow-emerald-500/25 transition-all active:scale-98 flex items-center justify-center gap-2">
                <i class="fa-solid fa-rotate-right"></i> Recommencer une Session
            </button>
        </div>
    </div>

    <!-- HELP MODAL -->
    <div id="modal-help" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden transition-all duration-300">
        <div class="glass-panel max-w-lg w-full p-6 rounded-3xl shadow-2xl border border-slate-700/60">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-circle-info text-teal-400"></i> Instructions & Navigation
                </h3>
                <button onclick="closeHelpModal()" class="text-slate-400 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="space-y-3 text-sm text-slate-300 mb-6">
                <p><strong class="text-white">But du jeu :</strong> Parcourez l'atelier et trouvez les 5 dangers matérialisés ou anormaux.</p>
                <div class="p-3 bg-slate-900 rounded-xl space-y-2 text-xs">
                    <div class="flex justify-between items-center"><span class="text-slate-400">Déplacement clavier :</span> <span class="font-mono text-teal-300">Z, Q, S, D ou Flèches</span></div>
                    <div class="flex justify-between items-center"><span class="text-slate-400">Sauter / Monter :</span> <span class="font-mono text-teal-300">Barre d'espace</span></div>
                    <div class="flex justify-between items-center"><span class="text-slate-400">Orientation caméra :</span> <span class="font-mono text-teal-300">Glisser la souris</span></div>
                    <div class="flex justify-between items-center"><span class="text-slate-400">Interagir avec un risque :</span> <span class="font-mono text-teal-300">Clic gauche / Pointer VR</span></div>
                </div>
            </div>

            <button onclick="closeHelpModal()" class="w-full py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm transition">
                Fermer
            </button>
        </div>
    </div>

    <!-- 3D A-FRAME VR SCENE -->
    <div id="canvas-container" class="w-full h-full absolute inset-0 z-10">
        <a-scene embedded style="width: 100%; height: 100%;" cursor="rayOrigin: mouse" raycaster="objects: .clickable" vr-mode-ui="enabled: true">
            
            <!-- Assets Management -->
            <a-assets>
                <!-- Generated visual textures/colors -->
            </a-assets>

            <!-- CAMERA & CONTROLLERS -->
            <a-entity id="rig" position="0 0 7" movement-controls="speed: 0.2">
                <!-- Camera -->
                <a-camera id="camera" position="0 1.6 0" look-controls="pointerLockEnabled: false">
                    <!-- Cursor for gaze/desktop click feedback -->
                    <a-cursor id="cursor"
                        geometry="primitive: ring; radiusInner: 0.01; radiusOuter: 0.02"
                        material="color: #14b8a6; shader: flat"
                        position="0 0 -1"
                        raycaster="objects: .clickable">
                    </a-cursor>
                </a-camera>

                <!-- VR Controllers with Raycasters -->
                <a-entity laser-controls="hand: right" raycaster="objects: .clickable; far: 10" line="color: #14b8a6; opacity: 0.8"></a-entity>
                <a-entity laser-controls="hand: left" raycaster="objects: .clickable; far: 10" line="color: #14b8a6; opacity: 0.8"></a-entity>
            </a-entity>

            <!-- ENVIRONMENT LIGHTING -->
            <a-ambient-light color="#8899ac" intensity="0.65"></a-ambient-light>
            <a-directional-light color="#ffffff" intensity="0.8" position="-5 10 5" cast-shadow="true"></a-directional-light>
            <a-point-light color="#14b8a6" intensity="0.4" position="0 4 0"></a-point-light>

            <!-- WORKSHOP ROOM STRUCTURE -->
            <!-- Floor -->
            <a-plane position="0 0 0" rotation="-90 0 0" width="24" height="20" color="#334155" roughness="0.8"></a-plane>
            
            <!-- Floor Safety Walkway Lines (Yellow) -->
            <a-plane position="0 0.01 0" rotation="-90 0 0" width="0.2" height="18" color="#f59e0b"></a-plane>
            <a-plane position="-4 0.01 0" rotation="-90 0 0" width="0.2" height="18" color="#f59e0b"></a-plane>

            <!-- Back Wall -->
            <a-plane position="0 4 -10" rotation="0 0 0" width="24" height="8" color="#1e293b"></a-plane>
            <!-- Front Wall -->
            <a-plane position="0 4 10" rotation="0 180 0" width="24" height="8" color="#1e293b"></a-plane>
            <!-- Left Wall -->
            <a-plane position="-12 4 0" rotation="0 90 0" width="20" height="8" color="#1e293b"></a-plane>
            <!-- Right Wall -->
            <a-plane position="12 4 0" rotation="0 -90 0" width="20" height="8" color="#1e293b"></a-plane>
            <!-- Ceiling -->
            <a-plane position="0 8 0" rotation="90 0 0" width="24" height="20" color="#0f172a"></a-plane>

            <!-- Ceiling Beams -->
            <a-box position="0 7.8 -5" width="24" height="0.4" depth="0.4" color="#0284c7"></a-box>
            <a-box position="0 7.8 0" width="24" height="0.4" depth="0.4" color="#0284c7"></a-box>
            <a-box position="0 7.8 5" width="24" height="0.4" depth="0.4" color="#0284c7"></a-box>

            <!-- Safety Poster on Wall -->
            <a-plane position="-7 4.5 -9.9" width="3" height="2" color="#0f172a">
                <a-text value="RESTEV - SANTE AU TRAVAIL\nConsignes de Securite Atelier\n1. Port des EPI obligatoire\n2. Garder les voies degagees\n3. Signaler tout produit chimique" align="center" color="#ffffff" width="4.5" position="0 0 0.02"></a-text>
            </a-plane>

            <!-- WORKSHOP FURNITURE & PROPS -->

            <!-- Main Workbench 1 (Center Right) -->
            <a-entity id="workbench-1" position="5 0 -2">
                <!-- Tabletop -->
                <a-box position="0 1 0" width="3.5" height="0.15" depth="1.5" color="#475569"></a-box>
                <!-- Legs -->
                <a-box position="-1.6 0.5 -0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <a-box position="1.6 0.5 -0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <a-box position="-1.6 0.5 0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <a-box position="1.6 0.5 0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <!-- Tool Box on Table -->
                <a-box position="1 1.25 -0.2" width="0.8" height="0.35" depth="0.4" color="#dc2626"></a-box>
            </a-entity>

            <!-- Secondary Workbench 2 (Left) -->
            <a-entity id="workbench-2" position="-6 0 -4">
                <a-box position="0 1 0" width="3" height="0.15" depth="1.4" color="#475569"></a-box>
                <a-box position="-1.4 0.5 -0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <a-box position="1.4 0.5 -0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <a-box position="-1.4 0.5 0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
                <a-box position="1.4 0.5 0.6" width="0.1" height="1" depth="0.1" color="#1e293b"></a-box>
            </a-entity>

            <!-- Industrial Machine / Lathe Structure (Center Back) -->
            <a-entity id="heavy-machine" position="0 0 -7">
                <a-box position="0 1.2 0" width="4" height="2.4" depth="1.8" color="#334155"></a-box>
                <a-box position="0 2.5 0" width="3.6" height="0.3" depth="1.4" color="#0284c7"></a-box>
                <!-- Control Panel -->
                <a-box position="1.2 1.6 0.95" width="0.8" height="0.9" depth="0.1" color="#0f172a"></a-box>
                <a-cylinder position="1.4 1.8 1.02" radius="0.08" height="0.05" rotation="90 0 0" color="#ef4444"></a-cylinder>
                <a-cylinder position="1.0 1.8 1.02" radius="0.06" height="0.05" rotation="90 0 0" color="#22c55e"></a-cylinder>
            </a-entity>

            <!-- Storage Racks (Right Wall) -->
            <a-entity position="11 0 -2" rotation="0 -90 0">
                <a-box position="0 2 0" width="4" height="0.1" depth="1.2" color="#64748b"></a-box>
                <a-box position="0 1 0" width="4" height="0.1" depth="1.2" color="#64748b"></a-box>
                <a-box position="-1.9 1.5 0" width="0.1" height="3" depth="1.2" color="#334155"></a-box>
                <a-box position="1.9 1.5 0" width="0.1" height="3" depth="1.2" color="#334155"></a-box>
            </a-entity>


            <!-- HAZARD 1: Unlabeled Chemical Drum (Right side) -->
            <a-entity id="hazard-1" class="clickable" hazard-item="id: 1" position="8 0 -3">
                <!-- Drum Mesh -->
                <a-cylinder id="drum-mesh" position="0 0.9 0" radius="0.55" height="1.8" color="#ea580c" roughness="0.3">
                    <a-ring position="0 0.5 0.56" radius-inner="0.15" radius-outer="0.25" color="#fef08a" rotation="0 0 0"></a-ring>
                    <a-text value="?" position="0 0.5 0.58" align="center" color="#000" width="4"></a-text>
                </a-cylinder>

                <!-- Interactive Glow / Indicator Pulsing Halo -->
                <a-ring id="halo-1" position="0 0.02 0" rotation="-90 0 0" radius-inner="0.7" radius-outer="0.9" color="#f59e0b" material="transparent: true; opacity: 0.7" class="animate-pulse-glow"></a-ring>
                
                <a-text id="label-1" value="PRODUIT SANS ETIQUETTE" position="0 2.1 0" align="center" color="#fbbf24" width="4" side="double"></a-text>
            </a-entity>


            <!-- HAZARD 2: Blocked Emergency Exit (Back Left Wall) -->
            <a-entity id="hazard-2" class="clickable" hazard-item="id: 2" position="-10 0 -9.8">
                <!-- Emergency Door Frame -->
                <a-box position="0 2 0" width="2.2" height="4" depth="0.1" color="#15803d"></a-box>
                <a-plane position="0 3.7 0.06" width="1.8" height="0.4" color="#22c55e">
                    <a-text value="SORTIE D'URGENCE" align="center" color="#ffffff" width="3" position="0 0 0.01"></a-text>
                </a-plane>

                <!-- Blocking Pallets & Crates stacked in front -->
                <a-entity id="blocking-crates" position="0 0 0.6">
                    <a-box position="-0.3 0.4 0" width="1.2" height="0.8" depth="0.9" color="#b45309"></a-box>
                    <a-box position="0.4 0.3 0.2" width="1.0" height="0.6" depth="0.8" color="#d97706"></a-box>
                    <a-box position="0 0.9 0" width="1.0" height="0.6" depth="0.7" color="#78350f"></a-box>
                </a-entity>

                <!-- Pulsing Indicator -->
                <a-ring id="halo-2" position="0 0.02 0.8" rotation="-90 0 0" radius-inner="1.0" radius-outer="1.2" color="#f59e0b" material="transparent: true; opacity: 0.7"></a-ring>
                <a-text id="label-2" value="SORTIE BLOMQUEE" position="0 2.5 0.8" align="center" color="#fbbf24" width="4" side="double"></a-text>
            </a-entity>


            <!-- HAZARD 3: Exposed Damaged Wire on Floor (Center Walkway) -->
            <a-entity id="hazard-3" class="clickable" hazard-item="id: 3" position="-1 0 1">
                <!-- Loose Cable running across path -->
                <a-cylinder id="cable-mesh" position="0 0.03 0" radius="0.04" height="3" rotation="90 0 45" color="#0f172a"></a-cylinder>
                <!-- Exposed Stripped Copper Spark Zone -->
                <a-sphere id="spark-mesh" position="0 0.05 0" radius="0.12" color="#ef4444" material="emissive: #f97316; emissiveIntensity: 0.8"></a-sphere>

                <!-- Pulsing Indicator -->
                <a-ring id="halo-3" position="0 0.02 0" rotation="-90 0 0" radius-inner="0.5" radius-outer="0.7" color="#f59e0b" material="transparent: true; opacity: 0.7"></a-ring>
                <a-text id="label-3" value="CABLE ELECTRIQUE NUDE" position="0 0.8 0" align="center" color="#fbbf24" width="3.5" side="double"></a-text>
            </a-entity>


            <!-- HAZARD 4: Oil Spill Slick (Near Machine) -->
            <a-entity id="hazard-4" class="clickable" hazard-item="id: 4" position="-2 0 -5">
                <!-- Oil puddle mesh -->
                <a-cylinder id="oil-mesh" position="0 0.01 0" radius="1.1" height="0.01" color="#020617" roughness="0.1" metalness="0.8"></a-cylinder>

                <!-- Pulsing Indicator -->
                <a-ring id="halo-4" position="0 0.02 0" rotation="-90 0 0" radius-inner="1.2" radius-outer="1.4" color="#f59e0b" material="transparent: true; opacity: 0.7"></a-ring>
                <a-text id="label-4" value="FLAQUE D'HUILE GLISSANTE" position="0 1.0 0" align="center" color="#fbbf24" width="3.5" side="double"></a-text>
            </a-entity>


            <!-- HAZARD 5: Unprotected Bench Grinder Machine (Workbench 2) -->
            <a-entity id="hazard-5" class="clickable" hazard-item="id: 5" position="-6 1.08 -4">
                <!-- Grinder Motor Base -->
                <a-box position="0 0.2 0" width="0.6" height="0.3" depth="0.4" color="#1e293b"></a-box>
                <!-- Grinding Wheels -->
                <a-cylinder position="-0.35 0.25 0" radius="0.25" height="0.08" rotation="0 0 90" color="#64748b"></a-cylinder>
                <a-cylinder id="grinder-wheel" position="0.35 0.25 0" radius="0.25" height="0.08" rotation="0 0 90" color="#ef4444"></a-cylinder>

                <!-- Pulsing Indicator -->
                <a-ring id="halo-5" position="0 0.6 0" rotation="0 0 0" radius-inner="0.4" radius-outer="0.5" color="#f59e0b" material="transparent: true; opacity: 0.7"></a-ring>
                <a-text id="label-5" value="MEULEUSE SANS PROTECTION" position="0 0.9 0" align="center" color="#fbbf24" width="3.5" side="double"></a-text>
            </a-entity>

        </a-scene>
    </div>

    <script>
        /* State Management */
        const state = {
            started: false,
            audioEnabled: true,
            startTime: null,
            timerInterval: null,
            foundHazards: new Set(),
            totalHazards: 5
        };

        /* Hazard Database - RESTEV Occupational Safety Content */
        const hazardsData = {
            1: {
                title: "Bidon de Produit Chimique sans Étiquetage",
                category: "Risque Chimique / FDS",
                categoryClass: "bg-amber-500/20 text-amber-300 border-amber-500/30",
                description: "Un fût contenant un solvant ou produit toxique est déposé sans étiquette de danger CLP/SGH ni Fiche de Données de Sécurité (FDS) accessible.",
                regulation: "Code du Travail - Art. R4412-127 : Tout récipient contenant un produit chimique dangereux doit porter une étiquette claire indiquant les risques et les précautions d'emploi.",
                prevention: "Réétiqueter immédiatement le contenant avec les pictogrammes de danger réglementaires. Rendre la FDS accessible et former les opérateurs au port des EPI adaptés."
            },
            2: {
                title: "Issue de Secours Encombrée par des Palettes",
                category: "Risque d'Évacuation / Incendie",
                categoryClass: "bg-rose-500/20 text-rose-300 border-rose-500/30",
                description: "La porte de sortie d'urgence est complètement obstruée par un stockage temporaire de cartons et de palettes en bois.",
                regulation: "Code du Travail - Art. R4227-4 à R4227-14 : Les dégagements et voies d'évacuation doivent être maintenus libres de tout obstacle en permanence.",
                prevention: "Dégager immédiatement l'accès à la porte. Matérialiser une zone d'interdiction de dépôt au sol (hachures jaunes et noires) de 1,20 m minimum."
            },
            3: {
                title: "Câble Électrique Dénudé au Sol",
                category: "Risque Électrique & Chute",
                categoryClass: "bg-amber-500/20 text-amber-300 border-amber-500/30",
                description: "Un câble d'alimentation électrique détérioré traîne en travers de l'allée principale avec des conducteurs en cuivre apparents.",
                regulation: "Code du Travail - Art. R4226-1 : Les installations électriques doivent être maintenues en bon état d'isolement et protégées contre les détériorations mécaniques.",
                prevention: "Consigner/Mettre hors tension immédiatement l'équipement. Remplacer le cordon endommagé et installer un protège-câble de sol haute résistance."
            },
            4: {
                title: "Flaque d'Huile Mécanique Non Signalée",
                category: "Risque de Glissade / Chute de plein pied",
                categoryClass: "bg-blue-500/20 text-blue-300 border-blue-500/30",
                description: "Une fuite de lubrifiant sous une machine crée une zone glissante importante directement sur la voie de passage des opérateurs.",
                regulation: "INRS ED 6158 : Les chutes de plein pied représentent la 2ème cause d'accidents du travail. Le sol doit être propre, sec et sans obstacle.",
                prevention: "Balisersur-le-champ la zone avec un cône de danger, appliquer un absorbant végétal ou minéral, puis réparer la fuite carter de la machine."
            },
            5: {
                title: "Meuleuse d'Établi sans Écran de Protection ni EPI",
                category: "Risque de Projection / Équipement de travail",
                categoryClass: "bg-orange-500/20 text-orange-300 border-orange-500/30",
                description: "Le touret à meuler est utilisé sans son carter protecteur transparent et aucune paire de lunettes de sécurité n'est présente au poste.",
                regulation: "Code du Travail - Art. R4324-1 et R4324-21 : Les éléments mobiles de travail présentant un risque de projection doivent être munis de protecteurs efficaces.",
                prevention: "Fixer un écran pare-étincelles orientable en polycarbonate, régler le porte-pièce à 2 mm du disque et imposer le port obligatoire des lunettes/visière."
            }
        };

        /* A-Frame Component for Hazard Interaction */
        AFRAME.registerComponent('hazard-item', {
            schema: { id: { type: 'int' } },
            init: function () {
                const el = this.el;
                const hazardId = this.data.id;

                // Mouse / Pointer Hover Feedback
                el.addEventListener('mouseenter', () => {
                    if (!state.foundHazards.has(hazardId)) {
                        document.body.style.cursor = 'pointer';
                    }
                });

                el.addEventListener('mouseleave', () => {
                    document.body.style.cursor = 'default';
                });

                // Click / Trigger Event
                el.addEventListener('click', () => {
                    handleHazardSelect(hazardId);
                });
            }
        });

        /* WEB AUDIO API - Synthesized Sound Effects (No External Sound Files) */
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (!state.audioEnabled) return;
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            const now = audioCtx.currentTime;

            if (type === 'found') {
                // Success Chime (Two-Tone)
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, now); // C5
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.15); // A5
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
            } else if (type === 'victory') {
                // Fanfare chord sound
                [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
                    const subOsc = audioCtx.createOscillator();
                    const subGain = audioCtx.createGain();
                    subOsc.connect(subGain);
                    subGain.connect(audioCtx.destination);
                    subOsc.frequency.setValueAtTime(freq, now + i * 0.1);
                    subGain.gain.setValueAtTime(0.2, now + i * 0.1);
                    subGain.gain.exponentialRampToValueAtTime(0.01, now + i * 0.1 + 0.5);
                    subOsc.start(now + i * 0.1);
                    subOsc.stop(now + i * 0.1 + 0.5);
                });
            } else if (type === 'click') {
                // UI click
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, now);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                osc.start(now);
                osc.stop(now + 0.08);
            }
        }

        /* Start Simulation */
        function startSimulation() {
            playSound('click');
            document.getElementById('modal-welcome').classList.add('hidden');
            state.started = true;
            state.startTime = Date.now();
            
            // Start Timer
            state.timerInterval = setInterval(updateTimer, 1000);
        }

        /* Timer Update Function */
        function updateTimer() {
            if (!state.startTime) return;
            const elapsedSeconds = Math.floor((Date.now() - state.startTime) / 1000);
            const minutes = Math.floor(elapsedSeconds / 60).toString().padStart(2, '0');
            const seconds = (elapsedSeconds % 60).toString().padStart(2, '0');
            const timeStr = `${minutes}:${seconds}`;
            
            document.getElementById('timer-text').innerText = timeStr;
            document.getElementById('final-time').innerText = timeStr;
        }

        /* Handle Hazard Click */
        function handleHazardSelect(id) {
            if (!state.started) return;

            const isNew = !state.foundHazards.has(id);
            state.foundHazards.add(id);

            // Play Chime
            playSound('found');

            // Update 3D Visual State in Scene
            solveHazardIn3D(id);

            // Update Score HUD
            document.getElementById('score-text').innerText = `${state.foundHazards.size} / ${state.totalHazards}`;

            // Show Informational Modal
            const data = hazardsData[id];
            document.getElementById('hazard-category-badge').innerText = data.category;
            document.getElementById('hazard-category-badge').className = `px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider border ${data.categoryClass}`;
            document.getElementById('hazard-step-text').innerText = `${state.foundHazards.size} / ${state.totalHazards} Identifié${state.foundHazards.size > 1 ? 's' : ''}`;
            document.getElementById('hazard-title').innerText = data.title;
            document.getElementById('hazard-description').innerText = data.description;
            document.getElementById('hazard-regulation').innerText = data.regulation;
            document.getElementById('hazard-prevention').innerText = data.prevention;

            document.getElementById('modal-hazard').classList.remove('hidden');
        }

        /* Modify 3D Entities to show "Resolved" status */
        function solveHazardIn3D(id) {
            const halo = document.getElementById(`halo-${id}`);
            const label = document.getElementById(`label-${id}`);

            if (halo) {
                halo.setAttribute('color', '#22c55e'); // Green color
            }

            if (label) {
                label.setAttribute('color', '#4ade80');
                label.setAttribute('value', 'RISQUE IDENTIFIE & CORRIGE');
            }

            // Visual adaptations per object
            if (id === 1) { // Chemical drum
                const drum = document.getElementById('drum-mesh');
                drum.setAttribute('color', '#15803d'); // Safe Green
            } else if (id === 2) { // Exit
                const crates = document.getElementById('blocking-crates');
                crates.setAttribute('position', '2 0 0.6'); // Move out of the way
            } else if (id === 3) { // Electric cable
                const spark = document.getElementById('spark-mesh');
                spark.setAttribute('color', '#22c55e');
            } else if (id === 4) { // Oil
                const oil = document.getElementById('oil-mesh');
                oil.setAttribute('color', '#15803d');
            } else if (id === 5) { // Grinder
                const wheel = document.getElementById('grinder-wheel');
                wheel.setAttribute('color', '#15803d');
            }
        }

        /* Close Hazard Modal */
        function closeHazardModal() {
            playSound('click');
            document.getElementById('modal-hazard').classList.add('hidden');

            // Check for Victory
            if (state.foundHazards.size === state.totalHazards) {
                setTimeout(triggerVictory, 400);
            }
        }

        /* Trigger Victory Modal */
        function triggerVictory() {
            clearInterval(state.timerInterval);
            playSound('victory');
            document.getElementById('modal-victory').classList.remove('hidden');
        }

        /* Sound Toggle Function */
        function toggleAudio() {
            state.audioEnabled = !state.audioEnabled;
            const icon = document.getElementById('sound-icon');
            if (state.audioEnabled) {
                icon.className = 'fa-solid fa-volume-high text-teal-400';
            } else {
                icon.className = 'fa-solid fa-volume-xmark text-slate-500';
            }
        }

        /* Show/Hide Help Modals */
        function showHelpModal() {
            playSound('click');
            document.getElementById('modal-help').classList.remove('hidden');
        }

        function closeHelpModal() {
            playSound('click');
            document.getElementById('modal-help').classList.add('hidden');
        }

        /* Reset Simulation */
        function resetSimulation() {
            playSound('click');
            state.foundHazards.clear();
            clearInterval(state.timerInterval);
            state.startTime = Date.now();
            
            document.getElementById('score-text').innerText = `0 / ${state.totalHazards}`;
            document.getElementById('timer-text').innerText = '00:00';
            
            document.getElementById('modal-victory').classList.add('hidden');
            document.getElementById('modal-hazard').classList.add('hidden');
            document.getElementById('modal-welcome').classList.remove('hidden');

            // Reset 3D Hazard Visuals
            for (let i = 1; i <= 5; i++) {
                const halo = document.getElementById(`halo-${i}`);
                const label = document.getElementById(`label-${i}`);
                if (halo) halo.setAttribute('color', '#f59e0b');
                if (label) label.setAttribute('color', '#fbbf24');
            }

            document.getElementById('label-1').setAttribute('value', 'PRODUIT SANS ETIQUETTE');
            document.getElementById('drum-mesh').setAttribute('color', '#ea580c');

            document.getElementById('label-2').setAttribute('value', 'SORTIE BLOQUEE');
            document.getElementById('blocking-crates').setAttribute('position', '0 0 0.6');

            document.getElementById('label-3').setAttribute('value', 'CABLE ELECTRIQUE NUDE');
            document.getElementById('spark-mesh').setAttribute('color', '#ef4444');

            document.getElementById('label-4').setAttribute('value', 'FLAQUE D\'HUILE GLISSANTE');
            document.getElementById('oil-mesh').setAttribute('color', '#020617');

            document.getElementById('label-5').setAttribute('value', 'MEULEUSE SANS PROTECTION');
            document.getElementById('grinder-wheel').setAttribute('color', '#ef4444');

            // Reset Camera Position
            const rig = document.getElementById('rig');
            rig.setAttribute('position', '0 0 7');
        }
    </script>
</body>
</html>
